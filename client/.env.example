# Public URL of the Express API (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Manual payment number shown on checkout
NEXT_PUBLIC_BKASH_NUMBER=01609663539

# ---- Better Auth (runs inside Next.js) ----
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string   # must match server/.env
# Same database as the server (include the database name)
MONGODB_URI=mongodb://127.0.0.1:27017/brothers-crockeries
# Comma separated emails that receive the admin role when they sign up
ADMIN_EMAILS=mdjobair00441@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Image storage (only needed by the server, listed here for reference) ----
# CLOUDINARY_URL=
# IMAGEKIT_PUBLIC_KEY=

# ---- Email for password reset (optional; without it the reset link is printed in the terminal) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brothers Crockeries <orders@yourdomain.com>"
