# ---- Server ----
PORT=5000
NODE_ENV=development
# Next.js app origin(s), comma separated (CORS)
CLIENT_URL=http://localhost:3000

# ---- Database (must include the database name; use the SAME value in client/.env) ----
MONGODB_URI=mongodb://127.0.0.1:27017/brothers-crockeries

# ---- Auth (must match client/.env) ----
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma separated emails that get the admin role
ADMIN_EMAILS=mdjobair00441@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Image storage: set ONE provider ----
# Option A: Cloudinary
CLOUDINARY_URL=
# Option B: ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---- Email (optional: order confirmation emails). Leave blank to skip sending ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brothers Crockeries <orders@yourdomain.com>"

# ---- Behind a proxy (Render, Railway, Nginx)? set to the number of proxies, e.g. 1 ----
TRUST_PROXY=
